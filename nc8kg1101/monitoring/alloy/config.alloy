// Ships every container's logs to Loki, read through the Docker API.
// Labels: container, stack (Compose project), service (Compose service), tier, logstream.
// The `stack` label comes from Compose itself, so a new Service needs no opt-in label.
// Also tails edge's Traefik access log (logstream=access, Common Log Format). Both redact keys
// and tokens in URLs. Replaces promtail and its `logging: promtail` opt-in label.
// hops logs --loki selects on `container` and `logstream`.

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "15s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "stack"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_tier"]
		target_label  = "tier"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "logstream"
	}
}

loki.source.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.containers.targets
	relabel_rules    = discovery.relabel.containers.rules
	refresh_interval = "15s"
	forward_to       = [loki.process.redact.receiver]
}

// Clients put API keys and tokens in Traefik's query strings, and blackbox logs a failed Probe's
// target (Dependency Probes can carry API keys, prometheus/dependencies.yml): keep them out of Loki.
loki.process "redact" {
	stage.replace {
		expression = "(?i)(?:api_?key|apikey|nzbkey|token|x-plex-token|access_token)=([^&\"\\s]+)"
		replace    = "REDACTED"
	}

	forward_to = [loki.write.local.receiver]
}

// Traefik's access log, readable through edge's group (service.yaml).
loki.source.file "traefik_access" {
	targets = [{
		__path__  = "/var/log/traefik/access.log",
		container = "traefik",
		stack     = "edge",
		service   = "traefik",
		tier      = "critical",
		logstream = "access",
	}]
	tail_from_end = true
	forward_to    = [loki.process.redact.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
