# Repo-root .env: client-side Host access for hops and agent sessions.
# Copy to .env (gitignored) and fill in. Never commit .env.
# Only the Operator edits .env; agents read it through hops and never print its values.
# Keys are per Host declared in hosts.yaml: HOPS_<NAME>_*, with NAME uppercased and "-" turned into "_".
# Secrets a Stack needs belong in SOPS under nc8kg1101/<stack>/, not here.

# The Host: SSH address (name or IP).
HOPS_NC8KG1101_SSH_HOST=

# The Host: SSH user that hops and agents log in as.
HOPS_NC8KG1101_SSH_USER=

# The Host: path to that user's SSH private key on this machine.
HOPS_NC8KG1101_SSH_KEY=
