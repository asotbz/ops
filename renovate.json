{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jbruns/homelab-components//renovate/repo-default#repo-ci-v1.0.2"
  ],
  "schedule": ["* 10-13 * * 5"],
  "packageRules": [
    {
      "description": "Disable Docker-sourced updates for portainer/portainer-ee (handled by custom manager)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["portainer/portainer-ee"],
      "enabled": false
    },
    {
      "description": "The setup-agent-skills wrapper's own PR, apart from the repo-ci group the preset puts every homelab-components tag in",
      "matchFileNames": ["tools/agent-skills/setup-agent-skills"],
      "groupName": "homelab-components agent-skills"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Use custom datasource for portainer-ee to only track LTS releases",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/",
        "/(^|/)service\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*portainer/portainer-ee:(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "portainer-ee",
      "datasourceTemplate": "custom.portainer-lts",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "setup-agent-skills wrapper: shared Repo Tooling pinned by tag and commit (homelab-components repo-tools/agent-skills README)",
      "managerFilePatterns": ["/(^|/)tools/agent-skills/setup-agent-skills$/"],
      "matchStrings": [
        "tag=(?<currentValue>agent-skills-v\\S+)\\s+commit=(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "jbruns/homelab-components",
      "versioningTemplate": "regex:^agent-skills-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customDatasources": {
    "portainer-lts": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/portainer/portainer/releases?per_page=100",
      "transformTemplates": [
        "{ \"releases\": $map($[$contains(name, \"LTS\")], function($v) { { \"version\": $v.tag_name, \"releaseTimestamp\": $v.published_at, \"sourceUrl\": \"https://github.com/portainer/portainer\", \"changelogUrl\": $v.html_url } }) }"
      ]
    }
  }
}
