# This repo's homelab-validate arguments, one option and its value per line. tools/validate/homelab-validate
# and CI (.github/workflows/validate.yaml) read them through validate_args.py, which refuses any other line.
#
# --path NAME=PATH: a homelab-validate input, passed explicitly so a missing one fails instead of being skipped.
#   When a PR adds a component homelab-validate reads (traefik, prometheus, rule-tests, alertmanager, loki,
#   alloy, grafana, ...), add its --path in the same PR. Names:
#   https://github.com/jbruns/homelab-components/blob/validate-v1.1.0/repo-tools/validate/README.md#inputs
--path traefik=nc8kg1101/edge/traefik/service.yaml
--path prometheus=nc8kg1101/monitoring/prometheus
--path rule-tests=tools/validate/rules
--path alertmanager=nc8kg1101/monitoring/alertmanager
--path loki=nc8kg1101/monitoring/loki
--path alloy=nc8kg1101/monitoring/alloy
--path blackbox=nc8kg1101/monitoring/blackbox-exporter/blackbox.yml
